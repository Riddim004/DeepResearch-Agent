# ── Model ─────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible chat completions endpoint works.
# Leave OPENAI_API_KEY empty to run the deterministic demo writer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# DeepSeek shortcut (used when OPENAI_API_KEY is empty)
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Generic aliases (also accepted)
# MODEL_API_KEY=
# MODEL_BASE_URL=
# MODEL_NAME=

# ── Search ────────────────────────────────────────────────────────────────────
# auto | duckduckgo | tavily | brave | serper | exa
# No key required: DuckDuckGo plus a free fallback stack
# (Wikipedia + Bing News RSS + arXiv) is used by default.
SEARCH_PROVIDER=auto
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# EXA_API_KEY=

# ── Harness ───────────────────────────────────────────────────────────────────
# Force the deterministic demo writer. Real web search still runs.
# DOSSIER_DEMO=1
# Demo typing speed in milliseconds (default 12).
# DOSSIER_DEMO_DELAY_MS=12
# SQLite and run events live here (default: ./.data).
# DOSSIER_DATA_DIR=./.data

# Optional cost display (USD per 1M tokens)
# MODEL_INPUT_USD_PER_1M=
# MODEL_OUTPUT_USD_PER_1M=

# Public origin used for Open Graph metadata in production
# SITE_URL=https://your-domain.example
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
